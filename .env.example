# Optional server-side Gemini key for Google Search source discovery,
# Gemini curation, or Gemini embeddings. Other providers use keys entered
# in the app's AI Provider settings.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Source discovery is a public route and every grounded search bills the key it
# runs on, so the server's own key is NOT used there unless you opt in.
# Set to 1 only on a deployment you control or with the route otherwise gated.
# ALLOW_SERVER_KEY=1

# Cloud Run sits behind a proxy that puts the real client in X-Forwarded-For.
# Per-IP rate limits need that header to identify callers; enable it only when
# this server is actually behind your own trusted proxy (the header is
# client-controlled otherwise).
# TRUST_PROXY=1

# How many trusted proxies sit in front of the server (default 1). The limiter
# reads the address the closest proxy appended, not the caller's first entry.
# Raise it to 2 only when a CDN fronts the first proxy AND the service cannot be
# reached directly (lock the origin to the CDN first). On a directly reachable
# origin, Cloud Run appends the caller's real address after their forged entries,
# so two hops would read a forged one and reopen the bypass.
# TRUST_PROXY_HOPS=1

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
